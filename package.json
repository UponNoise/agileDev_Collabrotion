{
  "name": "agiledev-collaboration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "vite build --config vite.config.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "start": "node --import tsx src/cli.ts serve",
    "desktop": "npm run build && node scripts/desktop.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "cli": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "8.3.6"
  }
}
